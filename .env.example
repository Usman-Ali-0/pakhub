# ==============================
# PISA-HUB Environment Variables
# Copy this file to .env and fill in the values
# ==============================

# ---- App ----
NODE_ENV=development
APP_NAME=PISA-HUB
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- JWT Auth ----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-too

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://pisahub:pisahub123@localhost:5432/pisahub

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- MinIO (Object Storage) ----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=pisahub_admin
MINIO_SECRET_KEY=pisahub_secret_123
MINIO_BUCKET_REPOS=repos
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_RELEASES=releases
MINIO_USE_SSL=false

# ---- Elasticsearch ----
ELASTICSEARCH_URL=http://localhost:9200

# ---- Git Storage ----
# Where bare git repositories are stored on disk
GIT_REPOS_PATH=./repos

# ---- Email (for notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@pisahub.com

# ---- AI — Built-in Free AI (Platform-level, admin sets these once) ----
# Get free key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Get free key at: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# ---- Encryption (for storing user BYOAI keys) ----
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# ---- SSH Server ----
SSH_PORT=2222
SSH_HOST_KEY_PATH=./ssh_host_key

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- Session ----
SESSION_SECRET=your-session-secret-here

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=PISA-HUB
NEXT_PUBLIC_WS_URL=ws://localhost:4000
